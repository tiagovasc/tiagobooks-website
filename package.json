{
  "name": "tiago-unified-personal-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/start-local.mjs",
    "build": "node scripts/build-local.mjs",
    "preview": "node scripts/start-local.mjs",
    "check:build": "node scripts/verify-release.mjs",
    "snapshot:urls": "node scripts/snapshot-urls.mjs",
    "check:urls": "node scripts/compare-urls.mjs",
    "check:links": "node scripts/check-links.mjs",
    "links:plan": "node scripts/migrate-links.mjs",
    "links:apply": "node scripts/migrate-links.mjs --apply",
    "links:undo": "node scripts/undo-link-migration.mjs",
    "lint:content": "node scripts/lint-content.mjs",
    "optimize:images": "node scripts/optimize-images.mjs",
    "start": "node server.mjs",
    "test": "node --test --test-concurrency=1 library/test-server.mjs library/test-server-prod.mjs library/test-tbr.mjs test-integration.mjs test-hardening.mjs test-artwork.mjs",
    "check:public": "node scripts/check-public.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.2.1",
    "astro": "^5.1.0",
    "js-yaml": "^5.5.0",
    "katex": "^0.16.11",
    "parse5": "^7.3.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.1",
    "sharp": "^0.35.5",
    "unified": "^11.0.5"
