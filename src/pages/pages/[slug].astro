---
import Entry from '../../layouts/Entry.astro';
import EpisodeList from '../../components/EpisodeList.astro';
import InterviewList from '../../components/InterviewList.astro';
import { getAllPages } from '../../lib/content';

export async function getStaticPaths() {
  const pages = await getAllPages();
  return pages.map((p) => ({ params: { slug: p.id }, props: { entry: p } }));
}
const { entry } = Astro.props;
---
<Entry entry={entry} kind="page" replaceBody={entry.id === 'interviews'}>
  {entry.id === 'podcast-overview' && !entry.data.protected && <EpisodeList />}
  {entry.id === 'interviews' && !entry.data.protected && <InterviewList body={entry.body ?? ''} />}
</Entry>
