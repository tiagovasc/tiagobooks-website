---
import Base from '../layouts/Base.astro';
---
<Base title="Edit writing" noindex>
  <h1 class="entry-title">Edit writing</h1>
  <p id="editor-help">Edit your posts and pages with your site login. <a href="/admin/" target="_blank" rel="noopener">Advanced GitHub editor</a></p>
  <p id="signin-again" role="alert" hidden>Your sign-in has ended. <a href="/login?next=%2Feditor" target="_blank" rel="noopener">Sign in again</a> in a new tab; your text here stays as it is.</p>
  <p id="publish-help" hidden>Publish only text ready to be public. Published revisions remain in the website’s public history. Keep private drafts elsewhere.</p>
  <form class="local-editor" id="editor">
    <label>Entry <select id="entry" aria-label="Entry"><option value="">Choose a post or page</option></select></label>
    <details><summary>Create an entry</summary><label>Collection <select id="kind"><option>posts</option><option>pages</option></select></label><label>URL name <input id="slug" pattern="[a-z0-9-]+" placeholder="my-new-essay" /></label><button type="button" id="new-entry" disabled>Create entry</button></details>
    <label for="markdown">Markdown and metadata</label><textarea id="markdown" spellcheck="false" disabled></textarea>
    <div><button id="save" disabled>Save changes</button> <button type="button" id="build" hidden>Rebuild preview</button></div>
    <p id="status" role="status">Loading entries…</p>
    <button type="button" id="retry-load" hidden>Try again</button>
  </form>
  <script>
    const $=(id:string)=>document.getElementById(id) as any;let revision='',current='',lineEnding='\n',remote=false,dirty=false,busy=false,loaded=false;
    const status=(s:string)=>$('status').textContent=s;
    async function api(path:string,options:any={}){const r=await fetch('/api/editor'+path,options);const signin=$('signin-again');if(signin)signin.hidden=r.status!==401;const d=await r.json();if(!r.ok)throw Error(d.error||'Request failed');return d}
    function controls(value:boolean){busy=value;for(const id of ['entry','new-entry','kind','slug','build'])$(id).disabled=value||!loaded;$('markdown').disabled=value||!current;$('save').disabled=value||!current;$('retry-load').disabled=value;}
    function addOption(file:string){if(!Array.from($('entry').options).some((o:any)=>o.value===file)){const o=document.createElement('option');o.value=file;o.textContent=file;$('entry').append(o)}}
    async function list(){controls(true);$('retry-load').hidden=true;status('Loading entries…');try{const d=await api('');remote=d.mode==='github';for(const file of d.files)addOption(file);loaded=true;$('save').textContent=remote?'Publish changes':'Save locally';$('build').hidden=remote;$('publish-help').hidden=!remote;status(remote?'Choose a post or page to edit.':'Choose an entry. Changes are saved in your local copy.')}catch(e:any){status(e.message);$('retry-load').hidden=loaded;}finally{controls(false)}}
    $('retry-load').addEventListener('click',()=>{if(!busy&&!loaded)return list();});
    $('entry').addEventListener('change',async()=>{const selected=$('entry').value;if(!selected||!confirmLeave()){$('entry').value=current;return}controls(true);status('Loading entry…');try{const d=await api('?file='+encodeURIComponent(selected));current=selected;revision=d.revision;lineEnding=d.text.includes('\r\n')?'\r\n':'\n';$('markdown').value=d.text;dirty=false;status('Editing '+current)}catch(e:any){$('entry').value=current;status(e.message)}finally{controls(false)}});
    function confirmLeave(){return !dirty||confirm('Discard unsaved edits?')} $('markdown').addEventListener('input',()=>dirty=true);window.addEventListener('beforeunload',e=>{if(dirty||busy){e.preventDefault();e.returnValue=''}});
    $('new-entry').addEventListener('click',()=>{if(busy||!loaded||!confirmLeave())return;const slug=$('slug').value;if(!/^[a-z0-9]+(?:-[a-z0-9]+)*$/.test(slug)){status('Use lowercase words separated by hyphens.');return}const file=$('kind').value+'/'+slug+'.md';if(Array.from($('entry').options).some((o:any)=>o.value===file)){status('That entry already exists. Choose it from the entry menu.');return}current=file;revision='new';$('entry').value='';$('markdown').value='---\ntitle: New entry\ndate: '+new Date().toISOString()+'\ndraft: '+(remote?'false':'true')+'\n---\n\n';dirty=true;controls(false);status('New entry: '+current+'. Nothing has been saved yet.');});
    $('editor').addEventListener('submit',async e=>{e.preventDefault();if(busy||!current)return;controls(true);status(remote?'Publishing changes…':'Saving changes…');try{const d=await api('',{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify({file:current,revision,text:$('markdown').value.replace(/\r?\n/g,lineEnding)})});revision=d.revision;dirty=false;addOption(current);$('entry').value=current;status(remote?(d.unchanged?'No changes to publish.':'Saved. Your changes will appear when the website finishes publishing, usually within a few minutes.'):'Saved '+current+'. Rebuild to update the preview.')}catch(e:any){status(e.message)}finally{controls(false)}});
    $('build').addEventListener('click',async()=>{if(busy)return;if(dirty){status('Save your edits before rebuilding.');return}controls(true);status('Building content and search…');try{await api('/build',{method:'POST'});status('Build passed. Open the website to review your changes.')}catch(e:any){status(e.message)}finally{controls(false)}});list();
  </script>
</Base>
