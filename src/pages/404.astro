---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" path="/404" noindex>
  <h1 class="entry-title">Page not found</h1>
  <p>That page doesn't exist. Search for it, or explore another part of the site.</p>
  <form action="/search" class="recovery-search"><label for="lostSearch">Search the website</label><div><input id="lostSearch" name="q" type="search" placeholder="Search posts and books" required/><button type="submit">Search</button></div></form>
  <nav class="recovery-links" aria-label="Find your way back"><a href="/search">Search</a><a href="/">Blog</a><a href="/library">Library</a><a href="/pages/books">Books</a><a href="/pages/podcast-overview">Podcasts</a></nav>
</Base>
