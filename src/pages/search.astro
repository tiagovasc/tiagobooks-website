---
import Base from '../layouts/Base.astro';
// 4 Nov 2026 redesign: one search box for blog, library and TBR, grouped results.
// The previous page is preserved in ../private/simplify-header-20261104/before/src/pages/search.astro.
---
<Base title="Search" path="/search">
  <h1 class="entry-title">Search</h1>
  <p class="search-guidance">Find essays, books and books to read by title, author or subject.</p>
  <div class="search-suggestions" id="search-suggestions">Try <a href="/search?q=beauty">beauty</a>, <a href="/search?q=Heidegger">Heidegger</a> or <a href="/search?q=consciousness">consciousness</a>.</div>
  <form class="ss-form" role="search" id="ss-form">
    <label class="ss-box"><svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="8.5" cy="8.5" r="5.5"/><path d="m13 13 4 4"/></svg><input id="ss-q" type="search" placeholder="Search posts, books and TBR" aria-label="Search posts, books and TBR" autocomplete="off" spellcheck="false" autofocus /></label>
  </form>
  <nav class="ss-scopes" aria-label="Search scope">
    <button type="button" data-scope="all" aria-pressed="true">All<span data-count="all"></span></button>
    <button type="button" data-scope="blog" aria-pressed="false">Blog<span data-count="blog"></span></button>
    <button type="button" data-scope="library" aria-pressed="false">Library<span data-count="library"></span></button>
    <button type="button" data-scope="tbr" aria-pressed="false">TBR<span data-count="tbr"></span></button>
  </nav>
  <p class="ss-status" id="ss-status" role="status"></p>
  <button type="button" class="ss-more" id="ss-retry" hidden>Retry search</button>
  <div id="ss-results"></div>
  <script>
    import {searchCatalogue,tbrHref,tbrLabel} from '../lib/catalogue-search.mjs';
    const $=(id:string)=>document.getElementById(id) as any;
    const esc=(s:any)=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'} as any)[c]);
    const LABEL:any={blog:'Blog',library:'Library',tbr:'TBR'};
    let scope='all',token=0,renderToken=0,timer:any=0,pagefind:any=null,lastQuery='';const data:any={};let last:any={blog:null,library:[],tbr:[]};const limit:any={};
    async function loadPagefind(){if(!pagefind){const url=new URL('/pagefind/pagefind.js',location.origin).href;pagefind=await import(/* @vite-ignore */ url);}return pagefind}
    // Library search uses the public list plus descriptions (so a description still matches), loaded in parallel.
    async function libraryBooks(){const [list,desc]=await Promise.all([fetch('/books.json?view=public'),fetch('/book-descriptions.json')]);if(!list.ok||!desc.ok)throw Error('unavailable');const d=await list.json(),map=await desc.json();return (Array.isArray(d)?d:d.books).map((b:any)=>b.has_description?{...b,description:map[b.id]||''}:b)}
    async function catalogue(kind:string){if(!data[kind]){if(kind==='library')data[kind]=await libraryBooks();else{const r=await fetch('/tbr-catalogue.json');if(!r.ok)throw Error('unavailable');data[kind]=(await r.json()).books}}return data[kind]}
    async function blogResults(q:string){const pf=await loadPagefind();const r=await pf.search(q);return {total:r.results.length,load:(n:number)=>Promise.all(r.results.slice(0,n).map((x:any)=>x.data()))}}
    // Results use the library's small web thumbnails (about a tenth of the bytes); the full cover is the fallback.
    const thumb=(c:string)=>{const m=/^covers\/([^\/]+?)(?:\.[A-Za-z0-9]+)?$/.exec(c||'');return m?'covers/web/'+m[1]+'.jpg':c};
    function bookRow(b:any,kind:string){const href=kind==='library'?'/library#book/'+encodeURIComponent(b.id):tbrHref(b);
      const shop=kind==='tbr'?tbrLabel(b):'';
      const meta=[b.author,kind==='library'?b.subject:shop].filter(Boolean).join(' · ');
      return `<a class="ss-row" href="${esc(href)}"><span class="ss-cover">${b.cover?`<img src="/${esc(thumb(b.cover))}" data-full="/${esc(b.cover)}" alt="" loading="lazy" decoding="async" onerror="if(this.dataset.full){this.src=this.dataset.full;this.removeAttribute('data-full')}else this.remove()">`:''}</span><span class="ss-text"><span class="ss-title">${esc(b.title||'Untitled')}</span>${meta?`<span class="ss-meta">${esc(meta)}</span>`:''}</span></a>`}
    function postRow(d:any){const kind=d.url.startsWith('/pages/')?'Page':'';return `<a class="ss-row ss-post" href="${esc(d.url)}"><span class="ss-text"><span class="ss-title">${esc(d.meta?.title||d.url)}</span>${kind?`<span class="ss-meta">${kind}</span>`:''}${d.excerpt?`<span class="ss-excerpt">${d.excerpt}</span>`:''}</span></a>`}
    async function run(){const q=$('ss-q').value.trim(),t=++token;const u=new URL(location.href);if(q)u.searchParams.set('q',q);else u.searchParams.delete('q');if(scope!=='all')u.searchParams.set('scope',scope);else u.searchParams.delete('scope');history.replaceState(null,'',u);
      renderToken++;$('ss-retry').hidden=true;$('ss-results').innerHTML='';
      if(q!==lastQuery){for(const k of Object.keys(limit))delete limit[k];lastQuery=q}
      $('search-suggestions').hidden=Boolean(q);
      if(!q){last={blog:null,library:[],tbr:[]};for(const el of document.querySelectorAll('[data-count]'))el.textContent='';$('ss-status').textContent='';$('ss-results').setAttribute('aria-busy','false');return}
      $('ss-status').textContent='Searching…';$('ss-results').setAttribute('aria-busy','true');
      try{const [blog,lib,tbr]=await Promise.all([blogResults(q).catch(()=>null),catalogue('library').then(b=>searchCatalogue(b,q)).catch(()=>null),catalogue('tbr').then(b=>searchCatalogue(b,q)).catch(()=>null)]);
        if(t!==token)return;last={blog,library:lib,tbr};await render()}catch(e){if(t===token){$('ss-status').textContent='Search is unavailable right now.';$('ss-retry').hidden=false;$('ss-results').setAttribute('aria-busy','false')}}}
    async function render(){const t=token,r=++renderToken,s=scope,result=last;const current=()=>t===token&&r===renderToken;
      $('ss-results').setAttribute('aria-busy','true');
      const kinds=s==='all'?['blog','library','tbr']:[s];
      const groups=await Promise.all(kinds.map(async k=>{const count=k==='blog'?result.blog?.total:result[k]?.length;if(!count)return '';
        const n=s==='all'?5:(limit[k]||40);
        try{const rows=k==='blog'?(await result.blog.load(n)).map(postRow):result[k].slice(0,n).map((b:any)=>bookRow(b,k));
          return `<section class="ss-group">${s==='all'?`<h2 class="ss-group-h"><span>${LABEL[k]}</span><span class="leader"></span><span class="ss-group-n">${count}</span></h2>`:''}${rows.join('')}${count>n?`<button type="button" class="ss-more" data-more="${k}">${s==='all'?'Show all '+count+' in '+LABEL[k]:'Show more'}</button>`:''}</section>`
        }catch{if(current())result[k]=null;return ''}}));
      if(!current())return;
      const counts:any={blog:result.blog?.total||0,library:result.library?.length||0,tbr:result.tbr?.length||0};counts.all=counts.blog+counts.library+counts.tbr;
      for(const el of document.querySelectorAll<HTMLElement>('[data-count]'))el.textContent=el.dataset.count!=='all'&&result[el.dataset.count!]===null?'':String(counts[el.dataset.count!]);
      const failed=kinds.filter(k=>result[k]===null),shown=kinds.reduce((n,k)=>n+counts[k],0);
      let message=shown?'':s==='all'?'No results. Try another word.':`No results in ${LABEL[s]}. Try another word or choose All.`;
      if(failed.length)message=failed.length===kinds.length&&s==='all'?'Search is unavailable right now. Please retry.':(shown||failed.length===kinds.length?'':'No matches in the available sources. ')+`${failed.map(k=>LABEL[k]).join(', ')} search is unavailable. Please retry.`;
      $('ss-status').textContent=message;$('ss-retry').hidden=!failed.length;$('ss-results').innerHTML=groups.join('');$('ss-results').setAttribute('aria-busy','false')}
    function setScope(s:string){scope=s;for(const b of document.querySelectorAll<HTMLElement>('[data-scope]'))b.setAttribute('aria-pressed',String(b.dataset.scope===s));run()}
    document.querySelector('.ss-scopes')!.addEventListener('click',e=>{const b=(e.target as HTMLElement).closest<HTMLElement>('[data-scope]');if(b)setScope(b.dataset.scope!)});
    $('ss-results').addEventListener('click',(e:any)=>{const b=e.target.closest('[data-more]');if(!b)return;const k=b.dataset.more;if(scope==='all')setScope(k);else{limit[k]=(limit[k]||40)+40;render()}});
    $('ss-form').addEventListener('submit',(e:Event)=>{e.preventDefault();clearTimeout(timer);run()});
    $('ss-retry').addEventListener('click',()=>{clearTimeout(timer);run()});
    $('ss-q').addEventListener('input',()=>{clearTimeout(timer);token++;renderToken++;$('ss-results').innerHTML='';$('ss-retry').hidden=true;$('ss-status').textContent=$('ss-q').value.trim()?'Searching…':'';timer=setTimeout(run,140)});
    const start=new URL(location.href);$('ss-q').value=start.searchParams.get('q')||'';const s=start.searchParams.get('scope');if(s&&LABEL[s])scope=s;
    for(const b of document.querySelectorAll<HTMLElement>('[data-scope]'))b.setAttribute('aria-pressed',String(b.dataset.scope===scope));
    loadPagefind().catch(()=>{});if($('ss-q').value)run();
  </script>
</Base>
