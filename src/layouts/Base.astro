---
import 'katex/dist/katex.min.css';
import '../styles/site.css';
import '../../public/unified.css';
import site from '../lib/site-config.mjs';
import { renderSiteHeader } from '../lib/site-shell.mjs';
import { layoutGuardMarkup } from '../lib/layout-ready.mjs';
import { getTagMap } from '../lib/content';
import { blogMenuSections, isBlogPostVisible } from '../lib/post-presentation.mjs';
import { normalizeSiteLink, absoluteSiteLink } from '../lib/link-policy.mjs';

interface Props {
  title?: string;
  description?: string;
  path?: string;
  image?: string;
  noindex?: boolean;
  type?: 'website' | 'article';
  published?: Date;
  updated?: Date;
  jsonLd?: Record<string, unknown>;
  pagefindBody?: boolean;
}
const {
  title, description = site.description, path = Astro.url.pathname, image,
  noindex = false, type = 'website', published, updated, jsonLd, pagefindBody = false,
} = Astro.props;

const canonical = new URL(path === '/' ? '/' : path, site.url).toString();
const imageUrl = image ? absoluteSiteLink(image) : undefined;
const isBlog = path === '/' || path === '/blog' || path.startsWith('/posts') || path.startsWith('/tag/');
const tagMap = isBlog ? await getTagMap() : new Map();
const tagChoices = blogMenuSections().map(label=>{
  const key=label.replace(/\s+/g,'-'),tag=tagMap.get(key);
  return [key,tag ? {...tag,posts:tag.posts.filter(post=>isBlogPostVisible(post))} : undefined] as const;
}).filter(([,tag])=>tag && tag.posts.length);
const activeTag = path.startsWith('/tag/') ? decodeURIComponent(path.slice(5)) : '';
---
<!doctype html>
<html lang={site.language.split('-')[0]} data-newtab={site.newTabForExternalLinks ? '' : undefined}>
  <head>
    <Fragment set:html={layoutGuardMarkup()} />
    <script is:inline>if(location.pathname==='/'&&/^#book\//.test(location.hash))location.replace('/library'+location.search+location.hash);</script>
    <script is:inline>try{let t=JSON.parse(localStorage.getItem("tiago-books-ui-v1")||"{}").theme;if(t==="light"||t==="dark")document.documentElement.setAttribute("data-theme",t)}catch{}</script>
    <link rel="stylesheet" href="/unified.css" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#EDEDEA" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />
    <title>{site.title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <link rel="alternate" type="application/atom+xml" title={site.title} href="/posts_feed" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:site_name" content={site.title} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title ?? site.title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="en_US" />
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    <meta name="twitter:card" content={imageUrl ? 'summary_large_image' : 'summary'} />
    {imageUrl && <meta name="twitter:image" content={imageUrl} />}
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    {updated && <meta property="article:modified_time" content={updated.toISOString()} />}
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <link rel="icon" href="/favicon.svg?v=quill-20261106" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico?v=quill-20261106" sizes="16x16 32x32 48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=quill-20261106" sizes="180x180" />
  </head>
  <body class="writing-site">
    <div id="top"></div>
    <a class="skip-link" href="#main">Skip to content</a>
    <Fragment set:html={renderSiteHeader(site,path)} />
    {isBlog && <aside class="section-tools" id="sectionTools" aria-label="Blog tools">
      <nav class="tag-chips" aria-label="Filter blog by tag">
        <a href="/blog" data-blog-tag="" aria-current={!activeTag && (path === '/' || path === '/blog') ? 'true' : undefined}>All posts</a>
        {tagChoices.map(([key,tag])=><a href={`/blog?tag=${encodeURIComponent(key)}`} data-blog-tag={key} aria-current={activeTag===key?'true':undefined}>{tag.label}<span>{tag.posts.length}</span></a>)}
      </nav>
    </aside>}
    <main id="main" tabindex="-1" data-pagefind-body={pagefindBody ? '' : undefined}>
      <slot />
    </main>
    {site.footerHtml && <div class="site-footer-html" set:html={site.footerHtml} />}
    <script is:inline src="/js/enhancements.js" defer></script>
    <script is:inline src="/js/library-warm.js" defer></script>
  <script is:inline src="/unified.js" defer></script>
  </body>
</html>
