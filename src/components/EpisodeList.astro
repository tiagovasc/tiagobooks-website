---
// Podcast page episode list (4 Nov 2026). Thumbnail and Read more open the episode's blog post;
// the three icons open the episode on YouTube, Spotify and Apple Podcasts.
import { getEpisodes } from '../lib/episodes';
const episodes = await getEpisodes();
---
<section class="ep-list" aria-label="Episodes" data-pagefind-ignore>
  {episodes.map((e) => (
    <article class="ep">
      <a class="ep-thumb" href={e.href} tabindex="-1" aria-hidden="true" style={`--episode-position:${e.crop.x}% ${e.crop.y}%;--episode-zoom:${e.crop.zoom}`}>
        {e.image
          ? <img src={e.image} alt="" loading="lazy" decoding="async" width="1280" height="720" />
          : e.youtubeId ? <img src={`https://i.ytimg.com/vi/${e.youtubeId}/hqdefault.jpg`} alt="" loading="lazy" decoding="async" /> : <span class="ep-thumb-empty">Anagoge Podcast</span>}
      </a>
      <div class="ep-body">
        <time datetime={e.iso}>{e.date}</time>
        <h2><a href={e.href}>{e.topic}</a></h2>
        {e.guest && <p class="ep-guest">with {e.guest}</p>}
        <p class="ep-desc">{e.teaser}</p>
        <div class="ep-actions">
          <a class="ep-read" href={e.href}>Read more<span aria-hidden="true">→</span></a>
          <span class="ep-sep" aria-hidden="true"></span>
          <a class="ep-icon" href={e.youtube} target="_blank" rel="noopener" aria-label={`Watch on YouTube: ${e.topic}`} title="YouTube"><img src="/icons/youtube.png" alt="" width="30" height="30" /></a>
          <a class="ep-icon" href={e.spotify} target="_blank" rel="noopener" aria-label={`Listen on Spotify: ${e.topic}`} title="Spotify"><img src="/icons/spotify.png" alt="" width="30" height="30" /></a>
          <a class="ep-icon" href={e.apple} target="_blank" rel="noopener" aria-label={`Listen on Apple Podcasts: ${e.topic}`} title="Apple Podcasts"><img src="/icons/apple-podcasts.png" alt="" width="30" height="30" /></a>
        </div>
      </div>
    </article>
  ))}
</section>
