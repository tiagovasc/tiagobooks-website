---
import { parseInterviews } from '../lib/interviews.mjs';
import EmbeddedVideo from './EmbeddedVideo.astro';
interface Props { body: string }
const interviews = parseInterviews(Astro.props.body);
---
<section class="ep-list interview-list" aria-label="Interviews">
  {interviews.map((item) => (
    <article class="ep">
      <EmbeddedVideo id={item.id} title={item.title}/>
      <div class="ep-body">
        {item.year && <time datetime={item.year}>{item.year}</time>}
        <h2>{item.title}</h2>
        {item.host && <p class="ep-guest">{item.host}</p>}
        {item.paragraphs.map(p => <p class="ep-desc">{p}</p>)}
        <div class="ep-actions">
          <a class="ep-read" href={item.href} target="_blank" rel="noopener" aria-label={`Watch ${item.title}`}>Watch on YouTube<span aria-hidden="true">→</span></a>
        </div>
      </div>
    </article>
  ))}
</section>
